# Cloudflare R2, for uploading product imagery. Copy to apps/backend/.env
# (which is gitignored) and fill in the two credential lines.
#
# The endpoint is https://<account-id>.r2.cloudflarestorage.com - the account id
# is on the R2 overview page in the Cloudflare dashboard. It is NOT the
# pub-xxxx id in the public URL.
R2_BUCKET=florayn-images
R2_PUBLIC_URL=https://pub-1af88507922d437983ab3ffaf7336788.r2.dev
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
