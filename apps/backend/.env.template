# Copy to .env and fill in. The values below are the local-development defaults.
DATABASE_URL=postgres://postgres:<password>@127.0.0.1:5432/florayn

STORE_CORS=http://localhost:8000,http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:3000,http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<random-32-byte-hex>
COOKIE_SECRET=<random-32-byte-hex>

MEDUSA_BACKEND_URL=http://localhost:9000

# Ad tracking (TRACKING.md 4.7). Server-only: never put these in a NEXT_PUBLIC_ variable.
# TRACKING_INGEST_SECRET: at least 32 random chars, the SAME value as the storefront's
#   TRACKING_INGEST_SECRET. It never travels over the wire; headers carry keys derived
#   from it. Unset or shorter than 32 chars, the backend rejects every tracking header
#   and ingest request (checkout still works, tracking stays off).
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TRACKING_INGEST_SECRET_PREVIOUS: optional, only while rotating the secret. Set it to the
#   old value, deploy the backend, then the storefront, then remove it.
# TRACKING_DRY_RUN: optional. 1 marks outbox rows dry_run and makes no network call to
#   Meta or TikTok (CI and local development).
# TRACKING_INGEST_SECRET=
# TRACKING_INGEST_SECRET_PREVIOUS=
# TRACKING_DRY_RUN=
