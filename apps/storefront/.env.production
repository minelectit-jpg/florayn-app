# Build-time configuration for the production storefront.
#
# Next.js replaces NEXT_PUBLIC_* with string literals when it compiles, so
# these must exist during `npm run build`, not merely at runtime. Setting them
# in a hosting dashboard that only injects variables when the process starts
# has no effect at all - the built bundle already contains whatever was in
# scope at build time, and a restart cannot change it. That is exactly how the
# backend URL once compiled down to its "http://localhost:9000" fallback and
# made a reachable catalogue look like an empty one.
#
# Committing these is safe: both are public by design. The publishable key is
# sent to every browser that loads the site, and the backend URL is the host
# those browsers call. Nothing secret belongs in this file - secrets have no
# way to stay secret once they are compiled into a browser bundle.

NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://nodejs-1666785-6651999.cloudwaysnodeapps.com
# This is PRODUCTION's own key, not the one in the local dump. They differ:
# the dump carries pk_1a9772e44..., and restoring it did not become the live
# key. Read the live one from Admin - Settings - Publishable API Keys, or
# straight from the database, and check here before blaming the storefront:
#   SELECT token FROM api_key WHERE type = 'publishable' AND revoked_at IS NULL;
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_4c1803d0685e6a6f61e47e21f2dc0be334910eea2b2f14de27e285953ec35d61
