# Build-time configuration for the production storefront.
#
# Next.js replaces NEXT_PUBLIC_* with string literals when it compiles, so
# these must exist during `npm run build` (the Docker build reads this file).
# Both values are public by design: the publishable key ships in every browser
# bundle, and the backend URL is the host those browsers call.
#
# These point at the self-hosted Coolify backend over its Cloudflare subdomain.
# NEXT_PUBLIC_* is baked at build, not read at runtime, so changing the backend
# host means editing this file and rebuilding the storefront. At the final
# cutover (florayn.com -> this server) this becomes https://api.florayn.com.

NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.new.florayn.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_b03c9297ef8eacee761a9c9a6890cdc8a3c364ae8d0163a47af63b2e300256a4
