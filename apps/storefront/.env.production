# Build-time configuration for the production storefront.
#
# Next.js replaces NEXT_PUBLIC_* with string literals when it compiles, so
# these must exist during `npm run build` (the Docker build reads this file).
# Both values are public by design: the publishable key ships in every browser
# bundle, and the backend URL is the host those browsers call.
#
# These currently point at the self-hosted Coolify backend (sslip.io host).
# When a real domain is attached (e.g. api.florayn.com) update the URL here and
# rebuild the storefront - NEXT_PUBLIC_* is baked at build, not read at runtime.

NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://imz48ytll8w57vdq4wi4fteu.157.245.202.205.sslip.io
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_da3389bdfd94efa3bc34f57f29401687a17755749adf4295f48c32bb7fc13744
