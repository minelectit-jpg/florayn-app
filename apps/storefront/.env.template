NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Created by the backend seed. Read it back with:
#   npm run backend:key
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...

# Ad tracking (TRACKING.md 4.7). Server-only: never put these in a NEXT_PUBLIC_ variable.
# TRACKING_INGEST_SECRET: at least 32 random chars, the SAME value as the backend's
#   TRACKING_INGEST_SECRET. It never travels over the wire; headers carry keys derived
#   from it. Unset or shorter than 32 chars, tracking is off: /api/t/* sets no cookies,
#   nothing is forwarded and checkout sends no tracking context.
# TRACKING_EDGE_SECRET: at least 32 random chars, the value of the x-florayn-edge header
#   the Cloudflare Transform Rule adds to every request. Requests without it are never
#   trusted: no cookies, no events, no IP or country (tracking stays inert until both
#   this and the Cloudflare rule are in place).
# TRACKING_DEV_TRUST_EDGE: local development only. 1 trusts requests without the edge
#   header under `next dev`; it has no effect when NODE_ENV is production (next start).
# TRACKING_INGEST_SECRET=
# TRACKING_EDGE_SECRET=
# TRACKING_DEV_TRUST_EDGE=
