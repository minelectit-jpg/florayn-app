{
  "name": "florayn",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "setup": "npm install && npm --prefix apps/storefront install",
    "dev": "turbo dev",
    "build": "turbo build && npm --prefix apps/storefront run build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:dev": "turbo dev --filter=@florayn/backend",
    "backend:seed": "turbo seed --filter=@florayn/backend",
    "backend:migrate": "turbo migrate --filter=@florayn/backend",
    "backend:key": "npm --prefix apps/backend run key",
    "storefront:dev": "npm --prefix apps/storefront run dev",
    "storefront:build": "npm --prefix apps/storefront run build",
    "storefront:typecheck": "npm --prefix apps/storefront run typecheck"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@medusajs/eslint-plugin": "2.19.0",
    "ajv": "^8.13.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/backend"
  ],
  "overrides": {
    "eslint": {
      "ajv": "^6.12.4"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.12.4"
    }
  }
}
